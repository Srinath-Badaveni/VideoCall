# ──────────────────────────────────────────────────
# VideoCall Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────

# Server
PORT=8080
NODE_ENV=development

# Database (MongoDB — will migrate to PostgreSQL in Stage 2)
MONGODB_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>

# JWT — REQUIRED. Generate a strong random secret.
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=3h

# CORS — comma-separated origins allowed to access the API
CORS_ORIGIN=http://localhost:3000

# Web Push (VAPID) — optional, push disabled without these
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@videocaller.app

# Redis — optional in development, required in production (Stage 2+)
REDIS_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
